---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<Fragment slot="head">
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0 0 2rem;
			}
			.hero-image {
				width: min(100% - 2rem, 1120px);
				margin: 2rem auto 0;
			}
			.hero-image img {
				display: block;
				width: 100%;
				max-height: 540px;
				border: 1px solid rgba(220, 226, 238, 0.9);
				border-radius: 20px;
				object-fit: cover;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 800px;
				max-width: calc(100% - 2rem);
				margin: auto;
				padding: 2.5rem 0 3rem;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 2rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid var(--line);
			}
			.title h1 {
				max-width: 780px;
				margin: 0;
				font-size: clamp(2.1rem, 5vw, 3.55rem);
				line-height: 1.06;
				letter-spacing: -0.04em;
			}
			.title hr {
				display: none;
			}
			.prose h2 {
				margin-top: 2.2rem;
				margin-bottom: 0.7rem;
				font-size: 1.48em;
				line-height: 1.3;
			}
			.prose h3 {
				margin-top: 1.7rem;
				margin-bottom: 0.6rem;
				font-size: 1.16em;
				line-height: 1.35;
			}
			.date {
				margin-bottom: 0.9rem;
				color: var(--accent-dark);
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
			.last-updated-on {
				margin-top: 0.2rem;
				color: rgb(var(--gray));
				font-style: italic;
				font-weight: 400;
				letter-spacing: 0;
				text-transform: none;
			}
			.feedback {
				margin-top: 3rem;
				padding: 1rem 1.2rem;
				border: 1px solid rgba(220, 226, 238, 0.95);
				border-left: 3px solid var(--accent);
				border-radius: 0 12px 12px 0;
				background: rgba(255, 255, 255, 0.75);
				color: rgb(var(--gray-dark));
				font-size: 0.92rem;
			}
			.feedback a {
				color: var(--accent-dark);
				font-weight: 700;
			}
			@media (max-width: 720px) {
				.hero-image {
					margin-top: 1.25rem;
				}
				.hero-image img {
					border-radius: 14px;
				}
				.prose {
					padding-top: 1.75rem;
				}
			}
		</style>
	</Fragment>

	<main>
		<article>
			<div class="hero-image">
				{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
			</div>
			<div class="prose">
				<div class="title">
					<div class="date">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<div class="last-updated-on">
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)
						}
					</div>
					<h1>{title}</h1>
					<hr />
				</div>
				<slot />
				<p class="feedback">
					Questions, corrections, or follow-up ideas are welcome on
					<a href="https://github.com/Blake-Guo/personal-blog/issues">GitHub Issues</a>.
				</p>
			</div>
		</article>
	</main>
</BaseLayout>
