---
import { SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`About | ${SITE_TITLE}`} description="About Blake Guo and this technical blog.">
	<Fragment slot="head">
		<style>
			main {
				width: min(100% - 2rem, 820px);
				margin: 0 auto;
				padding: 4.5rem 0 5rem;
				}
			main::before {
				display: block;
				width: 2.8rem;
				height: 0.28rem;
				margin-bottom: 1.25rem;
				border-radius: 99px;
				background: linear-gradient(90deg, var(--accent), var(--cyan));
				content: '';
			}
			h1 {
				margin-bottom: 1.25rem;
				font-size: clamp(2.6rem, 7vw, 4.5rem);
				line-height: 1;
			}
			h2 {
				margin: 3rem 0 0.85rem;
				font-size: 1.35rem;
			}
			p {
				color: rgb(var(--gray-dark));
				font-size: 1.08rem;
				line-height: 1.75;
			}
			main > p:first-of-type {
				max-width: 700px;
				padding: 1.4rem 1.5rem;
				border: 1px solid rgba(220, 226, 238, 0.95);
				border-radius: 16px;
				background: rgba(255, 255, 255, 0.8);
				box-shadow: 0 10px 28px rgba(34, 47, 85, 0.05);
			}
			.focus {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				margin: 1.5rem 0 0;
				padding: 0;
				list-style: none;
			}
			.focus li {
				padding: 0.4rem 0.8rem;
				border: 1px solid rgba(91, 95, 232, 0.15);
				border-radius: 999px;
				background: rgba(255, 255, 255, 0.72);
				color: #4b5480;
				font-size: 0.95rem;
				line-height: 1.4;
			}
			.contact {
				margin-top: 2.5rem;
				padding: 1.25rem 0 0;
				border-top: 1px solid var(--line);
				color: rgb(var(--gray));
				font-size: 0.98rem;
			}
			.contact a {
				color: var(--accent-dark);
				font-weight: 700;
			}
			@media (max-width: 720px) {
				main {
					padding-top: 3rem;
				}
				main > p:first-of-type {
					padding: 1.1rem 1.15rem;
				}
			}
		</style>
	</Fragment>
	<main>
		<h1>About Me</h1>
		<p>
			I am Blake Guo, an ML/AI platform engineer focused on the systems around AI models:
			data, retrieval, evaluation, and reliable production infrastructure.
		</p>

		<h2>Background</h2>
		<p>
			I have a PhD in Information Science, with research roots in data mining and distributed
			algorithms. Early in my career, I helped build and globally scale VMware Cloud on AWS. At
			Salesforce, I helped build global ML and data platforms, including Salesforce DMP and the
			Einstein Data Lake and Feature Store. I later founded an AI legaltech startup to help
			immigrants. Today, I am a founding engineer at Galvant.AI, building an AI brain and back
			office for manufacturing.
		</p>
		<ul class="focus">
			<li>ML/AI systems</li>
			<li>LLM applications</li>
			<li>retrieval and evaluation</li>
			<li>data infrastructure</li>
			<li>distributed systems</li>
			<li>cloud services</li>
			<li>reliability</li>
		</ul>

		<p class="contact">
			For questions, corrections, or technical discussion,
			<a href="https://github.com/Blake-Guo/personal-blog/issues">GitHub Issues</a> is the
			best place to reach me.
		</p>
	</main>
</BaseLayout>
