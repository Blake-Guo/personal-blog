---
import { SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`About | ${SITE_TITLE}`} description="About Blake Guo and this technical blog.">
	<Fragment slot="head">
		<style>
			main {
				width: min(100% - 2rem, 760px);
				margin: 0 auto;
				padding: 5rem 0;
			}
			h1 {
				margin-bottom: 1rem;
				font-size: clamp(2.25rem, 7vw, 4.5rem);
				line-height: 1;
			}
			h2 {
				margin: 3rem 0 0.75rem;
				font-size: 1.35rem;
			}
			p {
				color: rgb(var(--gray-dark));
				font-size: 1.08rem;
				line-height: 1.75;
			}
			.focus {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				margin: 1.5rem 0 0;
				padding: 0;
				list-style: none;
			}
			.focus li {
				padding: 0.35rem 0.7rem;
				border: 1px solid rgba(var(--gray-light), 90%);
				border-radius: 999px;
				color: rgb(var(--gray-dark));
				font-size: 0.95rem;
				line-height: 1.4;
			}
			.contact {
				margin-top: 2.5rem;
				padding-top: 1.25rem;
				border-top: 1px solid rgba(var(--gray-light), 90%);
				color: rgb(var(--gray));
				font-size: 0.98rem;
			}
			.contact a {
				color: rgb(var(--gray-dark));
			}
		</style>
	</Fragment>
	<main>
		<h1>About Me</h1>
		<p>
			I am Blake Guo, an ML/AI platform engineer building practical systems for language
			models, retrieval, data infrastructure, and cloud-native applications.
		</p>

		<h2>How I Think About Systems</h2>
		<p>
			My background spans large engineering organizations, early-stage ML/AI products, and a
			PhD in Information Science. I start from the data, understand the constraints, and
			design for reliability under real production load.
		</p>
		<ul class="focus">
			<li>ML/AI systems</li>
			<li>LLM applications</li>
			<li>retrieval and evaluation</li>
			<li>data infrastructure</li>
			<li>distributed systems</li>
			<li>cloud services</li>
			<li>reliability</li>
		</ul>

		<h2>What This Site Is For</h2>
		<p>
			I use this site for concise technical notes on ML/AI systems, distributed services,
			and data platforms: what I am learning, how systems are built, and which tradeoffs hold
			up in practice.
		</p>
		<p class="contact">
			For questions, corrections, or technical discussion,
			<a href="https://github.com/Blake-Guo/personal-blog/issues">GitHub Issues</a> is the
			best place to reach me.
		</p>
	</main>
</BaseLayout>
