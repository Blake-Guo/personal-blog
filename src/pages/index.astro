---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const collectionPosts = (await getCollection('blog')).map((post) => ({
	href: `/blog/${post.id}/`,
	title: post.data.title,
	description: post.data.description,
	pubDate: post.data.pubDate,
	heroImage: post.data.heroImage,
}));

// Standalone pages under src/pages that should appear alongside collection posts.
const standalonePosts = [
	{
		href: '/agent-architectures/',
		title: 'One Agent or a Team of Agents?',
		description:
			"It feels obvious that a team of AI agents should beat a single one. Three recent studies say: usually not — and the exceptions are where it gets interesting.",
		pubDate: new Date('2026-06-25'),
		heroImage: '/agent-architectures-hero.svg',
	},
];

const posts = [...collectionPosts, ...standalonePosts].sort(
	(a, b) => b.pubDate.valueOf() - a.pubDate.valueOf(),
);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<Fragment slot="head">
		<style>
			main {
				width: min(100% - 2rem, 1040px);
				margin: 0 auto;
				padding: 5rem 0 4rem;
			}
			.intro {
				display: grid;
				gap: 1rem;
				max-width: 760px;
				margin-bottom: 3rem;
			}
			.kicker {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			h1 {
				max-width: 760px;
				margin: 0;
				font-size: clamp(1.9rem, 4.5vw, 3.15rem);
				line-height: 1.08;
			}
			.intro p:last-child {
				max-width: 640px;
				margin: 0;
				color: rgb(var(--gray-dark));
				font-size: 1.15rem;
				line-height: 1.65;
			}
			.posts {
				display: grid;
				gap: 1.5rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-card a {
				display: grid;
				grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
				gap: 2rem;
				align-items: center;
				padding: 1.25rem 0;
				border-top: 1px solid rgba(var(--gray-light), 90%);
				color: inherit;
				text-decoration: none;
			}
			.post-card a:hover h2 {
				color: var(--accent);
			}
			.post-card img {
				width: 100%;
				aspect-ratio: 2 / 1;
				object-fit: cover;
				border-radius: 8px;
			}
			.post-meta {
				margin: 0 0 0.5rem;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			.post-card h2 {
				margin: 0 0 0.75rem;
				font-size: clamp(1.65rem, 3.4vw, 2.55rem);
				line-height: 1.06;
				transition: color 0.2s ease;
			}
			.post-card p {
				margin: 0;
				color: rgb(var(--gray-dark));
			}
			.empty {
				border-top: 1px solid rgba(var(--gray-light), 90%);
				padding-top: 2rem;
				color: rgb(var(--gray));
			}
			@media (max-width: 760px) {
				main {
					padding-top: 3rem;
				}
				.post-card a {
					grid-template-columns: 1fr;
					gap: 1rem;
				}
			}
		</style>
	</Fragment>
	<main>
		<section class="intro">
			<p class="kicker">ML/AI, distributed systems, data infrastructure</p>
			<h1>AI systems, data infrastructure, and engineering tradeoffs.</h1>
			<p>
				I write to turn technical learning into durable notes: concise explanations,
				implementation details, and ideas worth revisiting across ML/AI, distributed systems,
				and data platforms.
			</p>
		</section>
		{
			posts.length > 0 ? (
				<ul class="posts">
					{posts.map((post) => (
						<li class="post-card">
							<a href={post.href}>
								<div>
									<p class="post-meta">
										<FormattedDate date={post.pubDate} />
									</p>
									<h2>{post.title}</h2>
									<p>{post.description}</p>
								</div>
								{post.heroImage && <Image width={720} height={360} src={post.heroImage} alt="" />}
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="empty">No posts yet.</p>
			)
		}
	</main>
</BaseLayout>
