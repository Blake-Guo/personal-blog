---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const collectionPosts = (await getCollection('blog')).map((post) => ({
	href: `/blog/${post.id}/`,
	title: post.data.title,
	description: post.data.description,
	pubDate: post.data.pubDate,
	heroImage: post.data.heroImage,
}));

// Standalone pages under src/pages that should appear alongside collection posts.
const standalonePosts = [
	{
		href: '/agent-architectures/',
		title: 'One Agent or a Team of Agents?',
		description:
			"It feels obvious that a team of AI agents should beat a single one. Three recent studies say: usually not — and the exceptions are where it gets interesting.",
		pubDate: new Date('2026-06-25'),
		heroImage: '/agent-architectures-hero.svg',
	},
];

const posts = [...collectionPosts, ...standalonePosts].sort(
	(a, b) => b.pubDate.valueOf() - a.pubDate.valueOf(),
);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<Fragment slot="head">
		<style>
			main {
				width: min(100% - 2rem, 1080px);
				padding: 3.5rem 0 4rem;
			}
			.intro {
				position: relative;
				display: grid;
				grid-template-columns: minmax(0, 1.15fr) minmax(17rem, 0.75fr);
				gap: clamp(2rem, 5vw, 4.5rem);
				align-items: end;
				isolation: isolate;
				margin-bottom: 3.2rem;
				padding: clamp(2rem, 5vw, 3.8rem);
				border: 1px solid rgba(213, 220, 238, 0.9);
				border-radius: 26px;
				background:
					radial-gradient(ellipse at 88% 0%, rgba(120, 124, 245, 0.13), transparent 24rem),
					linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(248, 249, 255, 0.96));
				box-shadow: var(--box-shadow);
				overflow: hidden;
			}
			.intro::before {
				position: absolute;
				z-index: -1;
				top: 0;
				right: 0;
				width: 38%;
				height: 100%;
				background-image:
					linear-gradient(rgba(91, 95, 232, 0.055) 1px, transparent 1px),
					linear-gradient(90deg, rgba(91, 95, 232, 0.055) 1px, transparent 1px);
				background-size: 28px 28px;
				content: '';
				mask-image: linear-gradient(90deg, transparent, #000 65%);
			}
			.intro-heading {
				display: grid;
				gap: 1.2rem;
			}
			.kicker {
				display: flex;
				align-items: center;
				gap: 0.65rem;
				margin: 0;
				color: var(--accent-dark);
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}
			.kicker::before {
				width: 0.55rem;
				height: 0.55rem;
				border-radius: 50%;
				background: linear-gradient(135deg, var(--accent), var(--cyan));
				box-shadow: 0 0 0 4px rgba(91, 95, 232, 0.09);
				content: '';
			}
			h1 {
				max-width: 680px;
				margin: 0;
				font-size: clamp(2.25rem, 5.1vw, 4.15rem);
				line-height: 1.04;
				letter-spacing: -0.045em;
			}
			h1 span {
				color: var(--accent-dark);
			}
			.intro-summary {
				margin: 0;
				padding-left: 1.35rem;
				border-left: 1px solid rgba(91, 95, 232, 0.24);
				color: #53617a;
				font-size: 1.02rem;
				line-height: 1.75;
			}
			.listing-heading {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				margin: 0 0 1rem;
			}
			.posts-heading {
				margin: 0;
				color: rgb(var(--black));
				font-size: 1.1rem;
				letter-spacing: -0.01em;
			}
			.post-count {
				color: rgb(var(--gray));
				font-size: 0.82rem;
				font-variant-numeric: tabular-nums;
			}
			.posts {
				display: grid;
				gap: 1rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-card a {
				display: grid;
				grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 0.9fr);
				gap: clamp(1.25rem, 3vw, 2.5rem);
				align-items: center;
				padding: 1.2rem;
				border: 1px solid rgba(221, 227, 239, 0.95);
				border-radius: 20px;
				background: rgba(255, 255, 255, 0.88);
				box-shadow: 0 6px 22px rgba(34, 47, 85, 0.035);
				color: inherit;
				text-decoration: none;
				transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
			}
			.post-card a:hover {
				transform: translateY(-3px);
				border-color: rgba(91, 95, 232, 0.3);
				box-shadow: 0 15px 34px rgba(34, 47, 85, 0.1);
			}
			.post-card img {
				display: block;
				width: 100%;
				aspect-ratio: 16 / 9;
				border: 1px solid rgba(226, 231, 240, 0.9);
				border-radius: 13px;
				object-fit: cover;
			}
			.post-meta {
				margin: 0 0 0.7rem;
				color: var(--accent-dark);
				font-size: 0.76rem;
				font-weight: 700;
				letter-spacing: 0.055em;
				text-transform: uppercase;
			}
			.post-card h2 {
				margin: 0 0 0.65rem;
				font-size: clamp(1.45rem, 2.7vw, 2.05rem);
				line-height: 1.12;
				letter-spacing: -0.03em;
				transition: color 180ms ease;
			}
			.post-card a:hover h2 {
				color: var(--accent-dark);
			}
			.post-card p:not(.post-meta) {
				margin: 0;
				color: rgb(var(--gray-dark));
				line-height: 1.6;
			}
			.read-more {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				margin-top: 1.15rem;
				color: var(--accent-dark);
				font-size: 0.9rem;
				font-weight: 700;
			}
			.read-more span {
				transition: transform 180ms ease;
			}
			.post-card a:hover .read-more span {
				transform: translate(2px, -2px);
			}
			.empty {
				padding: 1.5rem;
				border: 1px solid var(--line);
				border-radius: 16px;
				background: white;
				color: rgb(var(--gray));
			}
			@media (max-width: 760px) {
				main {
					padding-top: 2.4rem;
				}
				.intro {
					grid-template-columns: 1fr;
					gap: 1.5rem;
					margin-bottom: 2.4rem;
					border-radius: 21px;
				}
				.intro-summary {
					max-width: 42rem;
				}
				.post-card a {
					grid-template-columns: 1fr;
					gap: 1rem;
					padding: 1rem;
				}
				.post-card img {
					grid-row: 1;
				}
			}
			@media (max-width: 480px) {
				.intro {
					padding: 1.5rem;
				}
				.intro-summary {
					padding-left: 1rem;
					font-size: 0.96rem;
				}
				.post-card a {
					border-radius: 16px;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.post-card a,
				.read-more span {
					transition: none;
				}
			}
		</style>
	</Fragment>
	<main>
		<section class="intro">
			<div class="intro-heading">
				<p class="kicker">Field notes for AI systems engineers</p>
				<h1>AI systems, data infrastructure, and <span>engineering tradeoffs.</span></h1>
			</div>
			<p class="intro-summary">
				AI is moving fast, and coding agents are taking on more of the implementation work. As the
				work changes, so does what engineers need to learn and remember. I write down the things I
				come across in practice that are worth knowing: core ideas, implementation details, and
				lessons from ML/AI, distributed systems, and data platforms.
			</p>
		</section>
		<div class="listing-heading">
			<h2 class="posts-heading">Latest writing</h2>
			<span class="post-count">{String(posts.length).padStart(2, '0')} articles</span>
		</div>
		{
			posts.length > 0 ? (
				<ul class="posts">
					{posts.map((post) => (
						<li class="post-card">
							<a href={post.href}>
								<div class="post-copy">
									<p class="post-meta"><FormattedDate date={post.pubDate} /></p>
									<h2>{post.title}</h2>
									<p>{post.description}</p>
									<span class="read-more">Read article <span aria-hidden="true">↗</span></span>
								</div>
								{post.heroImage && <Image width={720} height={405} src={post.heroImage} alt="" />}
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="empty">No posts yet.</p>
			)
		}
	</main>
</BaseLayout>
