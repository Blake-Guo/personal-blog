---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const collectionPosts = (await getCollection('blog')).map((post) => ({
	href: `/blog/${post.id}/`,
	title: post.data.title,
	description: post.data.description,
	pubDate: post.data.pubDate,
	heroImage: post.data.heroImage,
}));

// Standalone pages under src/pages that should appear alongside collection posts.
const standalonePosts = [
	{
		href: '/agent-architectures/',
		title: 'One Agent or a Team of Agents?',
		description:
			"It feels obvious that a team of AI agents should beat a single one. Three recent studies say: usually not — and the exceptions are where it gets interesting.",
		pubDate: new Date('2026-06-25'),
		heroImage: '/agent-architectures-hero.svg',
	},
];

const posts = [...collectionPosts, ...standalonePosts].sort(
	(a, b) => b.pubDate.valueOf() - a.pubDate.valueOf(),
);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<Fragment slot="head">
		<style>
			main {
				width: min(100% - 2rem, 1120px);
				padding: 3.5rem 0 5rem;
			}
			.intro {
				position: relative;
				display: grid;
				grid-template-columns: minmax(0, 1.3fr) minmax(17rem, 0.8fr);
				gap: clamp(2rem, 4vw, 4rem);
				align-items: center;
				isolation: isolate;
				margin-bottom: 3.5rem;
				padding: clamp(2rem, 4.5vw, 3.5rem);
				border: 1px solid #2c4761;
				border-radius: 18px;
				background:
					radial-gradient(ellipse at 90% 10%, rgba(78, 87, 175, 0.2), transparent 28rem),
					linear-gradient(135deg, #112239, #0b1829 68%);
				box-shadow: var(--box-shadow);
				overflow: hidden;
			}
			.intro::before {
				position: absolute;
				z-index: -1;
				right: 0;
				bottom: 0;
				width: 48%;
				height: 100%;
				background-image:
					linear-gradient(rgba(108, 178, 212, 0.08) 1px, transparent 1px),
					linear-gradient(90deg, rgba(108, 178, 212, 0.08) 1px, transparent 1px);
				background-size: 32px 32px;
				content: '';
				mask-image: linear-gradient(90deg, transparent, #000 55%);
			}
			.intro::after {
				position: absolute;
				top: 0;
				left: 3.5rem;
				width: 9rem;
				height: 2px;
				background: linear-gradient(90deg, var(--accent), var(--cyan), transparent);
				content: '';
			}
			.intro-copy {
				position: relative;
				z-index: 1;
			}
			.kicker {
				display: flex;
				align-items: center;
				gap: 0.7rem;
				margin: 0 0 1.3rem;
				color: var(--accent);
				font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.13em;
				text-transform: uppercase;
			}
			.kicker::before {
				width: 0.5rem;
				height: 0.5rem;
				border: 1px solid var(--accent);
				background: rgba(100, 230, 213, 0.3);
				box-shadow: 0 0 12px rgba(100, 230, 213, 0.4);
				content: '';
			}
			h1 {
				max-width: 660px;
				margin: 0;
				font-size: clamp(2.5rem, 4.9vw, 4.45rem);
				line-height: 1.05;
				letter-spacing: -0.045em;
			}
			h1 span {
				background: linear-gradient(100deg, #8db8ff, #7ff2df);
				background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.intro-summary {
				max-width: 58ch;
				margin: 1.55rem 0 0;
				color: #bdcee2;
				font-size: 1rem;
				line-height: 1.72;
			}
			.signal-panel {
				position: relative;
				z-index: 1;
				display: flex;
				flex-direction: column;
				height: 340px;
				border: 1px solid rgba(111, 159, 190, 0.3);
				border-radius: 11px;
				background:
					radial-gradient(circle at 51% 52%, rgba(59, 139, 166, 0.22), transparent 52%),
					rgba(6, 18, 32, 0.72);
				box-shadow: inset 0 0 35px rgba(16, 88, 117, 0.12), 0 20px 48px rgba(0, 6, 17, 0.2);
				overflow: hidden;
			}
			.signal-panel::before {
				position: absolute;
				inset: 0;
				background-image: radial-gradient(rgba(109, 191, 221, 0.17) 1px, transparent 1px);
				background-size: 20px 20px;
				content: '';
				mask-image: radial-gradient(circle, #000, transparent 73%);
			}
			.signal-heading,
			.signal-footer {
				position: relative;
				z-index: 1;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.7rem 0.9rem;
				color: #91aeca;
				font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
				font-size: 0.62rem;
				letter-spacing: 0.13em;
			}
			.signal-heading {
				border-bottom: 1px solid rgba(111, 159, 190, 0.19);
			}
			.signal-footer {
				margin-top: auto;
				border-top: 1px solid rgba(111, 159, 190, 0.19);
			}
			.signal-heading span:last-child {
				color: var(--accent);
			}
			.signal-panel svg {
				position: relative;
				z-index: 1;
				width: 100%;
				min-height: 0;
				flex: 1;
			}
			.listing-heading {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				margin: 0 0 1rem;
				padding-bottom: 0.9rem;
				border-bottom: 1px solid var(--line);
			}
			.posts-heading {
				margin: 0;
				font-size: 1.4rem;
			}
			.posts-heading::before {
				display: inline-block;
				width: 0.5rem;
				height: 0.5rem;
				margin-right: 0.7rem;
				background: var(--accent);
				content: '';
				vertical-align: 0.15em;
			}
			.post-count {
				color: rgb(var(--gray));
				font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
				font-size: 0.73rem;
				letter-spacing: 0.08em;
			}
			.posts {
				display: grid;
				gap: 0.9rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-card a {
				display: grid;
				grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 0.9fr);
				gap: clamp(1.25rem, 3vw, 2.5rem);
				align-items: center;
				padding: 1.2rem;
				border: 1px solid #24374c;
				border-radius: 13px;
				background: linear-gradient(120deg, rgba(19, 36, 55, 0.96), rgba(13, 26, 42, 0.96));
				color: inherit;
				text-decoration: none;
				transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
			}
			.post-card a:hover {
				transform: translateX(4px);
				border-color: rgba(100, 230, 213, 0.56);
				background: var(--surface-raised);
			}
			.post-card img {
				display: block;
				width: 100%;
				aspect-ratio: 16 / 9;
				border: 1px solid #3c5064;
				border-radius: 7px;
				background: #fff;
				object-fit: cover;
			}
			.post-meta {
				display: flex;
				align-items: center;
				gap: 0.65rem;
				margin: 0 0 0.8rem;
				color: var(--accent);
				font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
				font-size: 0.7rem;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}
			.post-index {
				padding-right: 0.65rem;
				border-right: 1px solid #3d5d6b;
				color: #82a4ba;
			}
			.post-card h2 {
				margin: 0 0 0.7rem;
				font-size: clamp(1.5rem, 2.7vw, 2.1rem);
				line-height: 1.15;
				letter-spacing: -0.03em;
				transition: color 180ms ease;
			}
			.post-card a:hover h2 {
				color: #a7e9ef;
			}
			.post-card p:not(.post-meta) {
				margin: 0;
				color: #aebfd4;
				line-height: 1.6;
			}
			.read-more {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				margin-top: 1.2rem;
				color: var(--accent);
				font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
				font-size: 0.78rem;
				font-weight: 700;
			}
			.empty {
				padding: 1.5rem;
				border: 1px solid var(--line);
				border-radius: 12px;
				background: var(--surface);
				color: rgb(var(--gray));
			}
			@media (max-width: 800px) {
				.intro {
					grid-template-columns: 1fr;
				}
				.signal-panel {
					height: 220px;
				}
				.post-card a {
					grid-template-columns: 1fr;
					gap: 1rem;
				}
				.post-card img {
					grid-row: 1;
				}
			}
			@media (max-width: 480px) {
				main {
					padding-top: 2rem;
				}
				.intro {
					gap: 1.7rem;
					margin-bottom: 2.4rem;
					padding: 1.45rem;
				}
				.intro::after {
					left: 1.45rem;
				}
				h1 {
					font-size: clamp(2.25rem, 10vw, 3rem);
				}
				.intro-summary {
					font-size: 0.96rem;
				}
				.post-card a {
					padding: 0.9rem;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.post-card a,
				.post-card h2 {
					transition: none;
				}
			}
		</style>
	</Fragment>
	<main>
		<section class="intro">
			<div class="intro-copy">
				<p class="kicker">Field notes for AI systems engineers</p>
				<h1>AI systems, data infrastructure, and <span>engineering tradeoffs.</span></h1>
				<p class="intro-summary">
					AI is moving fast, and coding agents are taking on more of the implementation work. As
					the work changes, so does what engineers need to learn and remember. I write down the
					things I come across in practice that are worth knowing: core ideas, implementation
					details, and lessons from ML/AI, distributed systems, and data platforms.
				</p>
			</div>
			<div class="signal-panel" aria-hidden="true">
				<div class="signal-heading"><span>SYSTEMS / MAP</span><span>◇</span></div>
				<svg viewBox="0 0 360 260" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M178 130L91 58M178 130l91-72M178 130l-87 73m87-73 91 73" stroke="#4e7890" stroke-width="1.5" />
					<path d="M91 58h-39m217 0h39M91 203H52m217 0h39" stroke="#4e7890" stroke-width="1.5" />
					<circle cx="178" cy="130" r="62" stroke="#3d6980" stroke-dasharray="3 7" />
					<circle cx="178" cy="130" r="39" fill="#143344" stroke="#71e5dc" stroke-width="1.5" />
					<circle cx="178" cy="130" r="31" stroke="#71e5dc" stroke-opacity=".32" />
					<text x="178" y="137" fill="#d8fbf5" font-size="22" font-family="ui-monospace,monospace" text-anchor="middle">AI</text>
					<circle cx="91" cy="58" r="15" fill="#16334b" stroke="#83b7ff" stroke-width="1.5" />
					<circle cx="269" cy="58" r="15" fill="#16334b" stroke="#83b7ff" stroke-width="1.5" />
					<circle cx="91" cy="203" r="15" fill="#16334b" stroke="#83b7ff" stroke-width="1.5" />
					<circle cx="269" cy="203" r="15" fill="#16334b" stroke="#83b7ff" stroke-width="1.5" />
					<circle cx="91" cy="58" r="3" fill="#83b7ff" /><circle cx="269" cy="58" r="3" fill="#83b7ff" />
					<circle cx="91" cy="203" r="3" fill="#83b7ff" /><circle cx="269" cy="203" r="3" fill="#83b7ff" />
					<circle cx="52" cy="58" r="2" fill="#71e5dc" /><circle cx="308" cy="58" r="2" fill="#71e5dc" />
					<circle cx="52" cy="203" r="2" fill="#71e5dc" /><circle cx="308" cy="203" r="2" fill="#71e5dc" />
				</svg>
				<div class="signal-footer"><span>MODELS</span><span>DATA</span><span>INFRASTRUCTURE</span></div>
			</div>
		</section>
		<div class="listing-heading">
			<h2 class="posts-heading">Latest writing</h2>
			<span class="post-count">{String(posts.length).padStart(2, '0')} ARTICLES</span>
		</div>
		{
			posts.length > 0 ? (
				<ul class="posts">
					{posts.map((post, index) => (
						<li class="post-card">
							<a href={post.href}>
								<div class="post-copy">
									<p class="post-meta"><span class="post-index">{String(index + 1).padStart(2, '0')}</span><FormattedDate date={post.pubDate} /></p>
									<h2>{post.title}</h2>
									<p>{post.description}</p>
									<span class="read-more">Read article <span aria-hidden="true">↗</span></span>
								</div>
								{post.heroImage && <Image width={720} height={405} src={post.heroImage} alt="" />}
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="empty">No posts yet.</p>
			)
		}
	</main>
</BaseLayout>
